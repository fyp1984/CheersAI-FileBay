# 仅用于内部试用。所有值都是合成测试值，部署时必须改成组织自己的随机值。
FILEBAY_HTTP_PORT=13080

# 该账号只能读取下面初始化脚本创建的脱敏视图；不得改为业务库账户。
KB_MYSQL_DSN=knowledge_reader:trial_only_reader_password@tcp(mysql-source:3306)/knowledge_source?charset=utf8mb4&parseTime=true&loc=Local
MYSQL_SOURCE_ROOT_PASSWORD=trial_only_root_password

# RAGFlow API 密钥与数据集 ID 不在 .env 中配置。请仅保存到被 Git 忽略的
# runtime/ragflow-binding/api-key 与 runtime/ragflow-binding/dataset-id。
