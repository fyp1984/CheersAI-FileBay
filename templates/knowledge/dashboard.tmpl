{{template "base/head" .}}
<div role="main" aria-label="{{ctx.Locale.Tr "knowledge.title"}}" class="page-content">
	<div class="ui container">
		{{template "base/alert" .}}
		<style>
			/* Dify-style workspace primitives: compact hierarchy, one interaction language, no native controls. */
			.knowledge-workbench { display: grid; grid-template-columns: 248px minmax(0, 1fr); gap: 36px; align-items: start; max-width: 1220px; margin: 0 auto; }
			.knowledge-sidebar { position: sticky; top: 20px; border: 1px solid var(--color-secondary-alpha-20); border-radius: 14px; background: var(--color-box-body); padding: 14px 12px; box-shadow: 0 8px 24px rgba(16, 24, 40, .035); }
			.knowledge-sidebar .brand { display: flex; align-items: center; gap: 9px; padding: 10px 12px 20px; font-size: 15px; font-weight: 700; letter-spacing: -.015em; }
			.knowledge-sidebar a { display: flex; align-items: center; justify-content: space-between; min-height: 40px; margin: 2px 0; padding: 9px 11px; border: 1px solid transparent; border-radius: 9px; color: var(--color-text-light-1); font-size: 14px; font-weight: 500; transition: background .15s ease, border-color .15s ease, color .15s ease; }
			.knowledge-sidebar a:hover { background: var(--color-hover); border-color: var(--color-secondary-alpha-20); color: var(--color-text); text-decoration: none; }
			.knowledge-sidebar a.active { background: var(--color-primary-light-2); border-color: var(--color-primary-light-1); color: var(--color-primary); font-weight: 700; }
			.knowledge-sidebar .section-label { padding: 20px 11px 7px; color: var(--color-text-light-2); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
			.knowledge-view { display: none; }
			.knowledge-overview { display: block; }
			.knowledge-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
			.knowledge-page-header .ui.header { margin: 0 0 7px; font-size: 27px; font-weight: 650; letter-spacing: -.035em; }
			.knowledge-page-header .description { max-width: 720px; color: var(--color-text-light-2); font-size: 14px; line-height: 1.65; }
			.knowledge-surface { border: 1px solid var(--color-secondary-alpha-20); border-radius: 14px; background: var(--color-box-body); box-shadow: 0 8px 24px rgba(16, 24, 40, .035); }
			.knowledge-surface > .content { padding: 22px; }
			.knowledge-surface-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 62px; padding: 17px 22px; border-bottom: 1px solid var(--color-secondary-alpha-20); font-size: 15px; font-weight: 700; letter-spacing: -.01em; }
			.knowledge-surface-title .text { font-size: 12px; font-weight: 400; }
			.knowledge-anchor { position: absolute; }
			{{if .KnowledgeSearchResult}}.knowledge-overview { display: none; } .knowledge-search { display: block; }{{end}}
			#knowledge-search:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-submit:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-tasks:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-space:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-data:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-upload:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-review:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-publish:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-library:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-connector:target ~ .knowledge-workbench .knowledge-view,
			#knowledge-apps:target ~ .knowledge-workbench .knowledge-view { display: none; }
			#knowledge-search:target ~ .knowledge-workbench .knowledge-search,
			#knowledge-submit:target ~ .knowledge-workbench .knowledge-submit,
			#knowledge-tasks:target ~ .knowledge-workbench .knowledge-tasks,
			#knowledge-space:target ~ .knowledge-workbench .knowledge-content,
			#knowledge-data:target ~ .knowledge-workbench .knowledge-data,
			#knowledge-upload:target ~ .knowledge-workbench .knowledge-content,
			#knowledge-review:target ~ .knowledge-workbench .knowledge-review,
			#knowledge-publish:target ~ .knowledge-workbench .knowledge-publish,
			#knowledge-library:target ~ .knowledge-workbench .knowledge-library,
			#knowledge-connector:target ~ .knowledge-workbench .knowledge-connector,
			#knowledge-apps:target ~ .knowledge-workbench .knowledge-apps { display: block; }
			#knowledge-space:target ~ .knowledge-workbench .knowledge-upload-card,
			#knowledge-upload:target ~ .knowledge-workbench .knowledge-space-card { display: none; }
			#knowledge-search:target ~ .knowledge-workbench a[data-step="search"],
			#knowledge-submit:target ~ .knowledge-workbench a[data-step="submit"],
			#knowledge-tasks:target ~ .knowledge-workbench a[data-step="tasks"],
			#knowledge-space:target ~ .knowledge-workbench a[data-step="space"],
			#knowledge-data:target ~ .knowledge-workbench a[data-step="source"],
			#knowledge-upload:target ~ .knowledge-workbench a[data-step="upload"],
			#knowledge-review:target ~ .knowledge-workbench a[data-step="review"],
			#knowledge-publish:target ~ .knowledge-workbench a[data-step="publish"],
			#knowledge-library:target ~ .knowledge-workbench a[data-step="library"],
			#knowledge-connector:target ~ .knowledge-workbench a[data-step="connector"],
			#knowledge-apps:target ~ .knowledge-workbench a[data-step="apps"] { background: var(--color-primary-light-2); color: var(--color-primary); font-weight: 700; }
			.knowledge-main .ui.form .field > label { margin-bottom: 8px; color: var(--color-text); font-size: 13px; font-weight: 650; }
			.knowledge-main .ui.form input:not([type="checkbox"]), .knowledge-main .ui.form textarea { min-height: 44px; border-color: var(--color-secondary-alpha-40); border-radius: 9px; box-shadow: none; font-size: 14px; transition: border-color .15s ease, box-shadow .15s ease; }
			.knowledge-main .ui.form textarea { min-height: 96px; }
			.knowledge-main .ui.form input:focus, .knowledge-main .ui.form textarea:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-light-2); }
			.knowledge-main .ui.selection.dropdown.knowledge-select { display: block; min-height: 44px; padding: 13px 42px 12px 13px; border-color: var(--color-secondary-alpha-40); border-radius: 9px; box-shadow: none; color: var(--color-input-text); font-size: 14px; line-height: 18px; transition: border-color .15s ease, box-shadow .15s ease, background .15s ease; }
			.knowledge-main .ui.selection.dropdown.knowledge-select:hover { background: var(--color-input-background); border-color: var(--color-primary); }
			.knowledge-main .ui.selection.dropdown.knowledge-select.active, .knowledge-main .ui.selection.dropdown.knowledge-select.visible { border-color: var(--color-primary); border-radius: 9px 9px 0 0; box-shadow: 0 0 0 3px var(--color-primary-light-2); }
			.knowledge-main .ui.selection.dropdown.knowledge-select > .dropdown.icon { top: 50%; right: 13px; margin: 0; padding: 0; transform: translateY(-50%); color: var(--color-text-light-2); }
			.knowledge-main .ui.selection.dropdown.knowledge-select .menu { margin-top: 6px; border: 1px solid var(--color-secondary-alpha-40) !important; border-radius: 10px !important; box-shadow: 0 12px 28px rgba(16, 24, 40, .14) !important; }
			.knowledge-main .ui.selection.dropdown.knowledge-select .menu > .item { min-height: 42px; padding: 11px 13px !important; border: 0; color: var(--color-text-light-1); font-size: 14px; }
			.knowledge-main .ui.selection.dropdown.knowledge-select .menu > .item:hover, .knowledge-main .ui.selection.dropdown.knowledge-select .menu > .active.item { background: var(--color-primary-light-2); color: var(--color-primary); }
			.knowledge-main .ui.primary.button { min-height: 42px; padding: 0 16px; border-radius: 9px; box-shadow: none; font-weight: 650; transition: transform .15s ease, box-shadow .15s ease; }
			.knowledge-main .ui.primary.button:hover { transform: translateY(-1px); box-shadow: 0 5px 12px var(--color-primary-light-1); }
			.knowledge-main .ui.basic.button { border-radius: 8px; box-shadow: inset 0 0 0 1px var(--color-secondary-alpha-40) !important; }
			.knowledge-main .ui.label { border-radius: 999px; font-size: 12px; font-weight: 650; }
			.knowledge-main .help, .knowledge-main .hint { margin-top: 7px; color: var(--color-text-light-2); font-size: 12px; line-height: 1.65; }
			.knowledge-main .ui.message { border: 1px solid var(--color-secondary-alpha-20); border-radius: 10px; box-shadow: none; }
			.knowledge-advanced { margin-top: 16px; border: 1px solid var(--color-secondary-alpha-20); border-radius: 10px; padding: 14px 16px; background: var(--color-box-body); }
			.knowledge-advanced summary { cursor: pointer; font-weight: 600; }
			.knowledge-advanced .hint { color: var(--color-text-light-2); margin: 8px 0 14px; }
			.knowledge-next-step { margin-bottom: 16px; }
			.knowledge-next-step .workflow-card { color: var(--color-text); border: 1px solid var(--color-secondary-alpha-20); border-radius: 14px; box-shadow: 0 2px 6px rgba(16, 24, 40, .02); transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease; }
			.knowledge-next-step .workflow-card:hover { border-color: var(--color-primary); color: var(--color-text); text-decoration: none; transform: translateY(-2px); box-shadow: 0 12px 24px rgba(16, 24, 40, .09); }
			.knowledge-step-kicker { color: var(--color-primary); font-size: 11px; font-weight: 700; letter-spacing: .06em; margin-bottom: 8px; text-transform: uppercase; }
			.knowledge-choice { min-height: 138px; }
			.knowledge-choice .header { font-size: 17px !important; letter-spacing: -.02em; }
			.knowledge-choice .description { margin-top: 7px; color: var(--color-text-light-2) !important; line-height: 1.65; }
			.knowledge-flow { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; margin: 0 0 22px; padding: 0; overflow: hidden; border: 1px solid var(--color-secondary-alpha-20); border-radius: 12px; background: var(--color-box-body); }
			.knowledge-flow-step { display: flex; align-items: center; gap: 8px; min-height: 58px; padding: 10px 13px; border-right: 1px solid var(--color-secondary-alpha-20); color: var(--color-text-light-2); font-size: 12px; }
			.knowledge-flow-step:last-child { border-right: 0; }
			.knowledge-flow-step strong { display: inline-grid; width: 20px; height: 20px; place-items: center; border-radius: 50%; background: var(--color-primary-light-2); color: var(--color-primary); font-size: 11px; }
			.knowledge-current-step { margin-bottom: 20px; padding: 15px 17px; border: 1px solid var(--color-primary-light-1); border-radius: 12px; background: var(--color-primary-light-2); color: var(--color-text); line-height: 1.65; }
			.knowledge-current-step strong { color: var(--color-primary); }
			.knowledge-admin-note { margin-top: 16px; padding: 13px 15px; border-radius: 10px; background: var(--color-hover); color: var(--color-text-light-2); font-size: 13px; line-height: 1.65; }
			.knowledge-list-card { margin-top: 18px; overflow: hidden; border: 1px solid var(--color-secondary-alpha-20); border-radius: 12px; background: var(--color-box-body); }
			.knowledge-main .ui.top.attached.header { margin: 0; min-height: 62px; padding: 18px 22px; border: 1px solid var(--color-secondary-alpha-20); border-bottom: 0; border-radius: 14px 14px 0 0; background: var(--color-box-body); font-size: 16px; font-weight: 700; letter-spacing: -.01em; }
			.knowledge-main .ui.attached.segment { border-color: var(--color-secondary-alpha-20); border-radius: 0 0 14px 14px; box-shadow: 0 8px 24px rgba(16, 24, 40, .035); }
			.knowledge-main .ui.table { margin: 0; border-collapse: separate; border-spacing: 0; }
			.knowledge-main .ui.table thead th { padding: 13px 14px; border-bottom: 1px solid var(--color-secondary-alpha-20); background: var(--color-hover); color: var(--color-text-light-2); font-size: 12px; font-weight: 700; }
			.knowledge-main .ui.table tbody td { padding: 14px; border-top: 1px solid var(--color-secondary-alpha-20); vertical-align: middle; }
			.knowledge-main .ui.table tbody tr:first-child td { border-top: 0; }
			.knowledge-main .ui.table code { padding: 2px 6px; border-radius: 5px; background: var(--color-hover); font-size: 12px; }
			.knowledge-list-card .ui.table { margin: 0; }
			.knowledge-main .ui.checkbox label { color: var(--color-text-light-1); font-size: 13px; line-height: 1.55; }
			.knowledge-main .ui.placeholder.segment { min-height: 180px; border: 1px dashed var(--color-secondary-alpha-40); border-radius: 12px; box-shadow: none; }
			/* A workflow exposes one task at a time: its surface should use the entire main canvas. */
			.knowledge-content > .ui.two.column.stackable.grid { display: block; margin: 0 !important; }
			.knowledge-content > .ui.two.column.stackable.grid > .column { width: 100% !important; padding: 0 !important; }
			.knowledge-entry-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; }
			.knowledge-entry-form > .field { margin: 0 !important; }
			.knowledge-entry-form > .field:nth-of-type(3),
			.knowledge-entry-form > .inline.field,
			.knowledge-entry-form > .ui.primary.button,
			.knowledge-entry-form > .help,
			.knowledge-entry-form > .knowledge-advanced { grid-column: 1 / -1; }
			.knowledge-entry-form > .inline.field { margin-top: -2px !important; }
			.knowledge-entry-form > .ui.primary.button { justify-self: start; margin: 0; }
			@media (max-width: 767px) { .knowledge-entry-form { grid-template-columns: 1fr; } .knowledge-entry-form > * { grid-column: auto !important; } }
			@media (max-width: 1000px) { .knowledge-flow { grid-template-columns: repeat(3, minmax(0, 1fr)); } .knowledge-flow-step:nth-child(3) { border-right: 0; } }
			@media (max-width: 767px) { .knowledge-workbench { display: block; } .knowledge-sidebar { position: static; margin-bottom: 16px; } .knowledge-sidebar a { display: inline-block; } }
			@media (max-width: 767px) { .knowledge-page-header { display: block; } .knowledge-flow { grid-template-columns: 1fr; } .knowledge-flow-step { border-right: 0; border-bottom: 1px solid var(--color-secondary-alpha-20); } .knowledge-flow-step:last-child { border-bottom: 0; } }
		</style>
		<i id="knowledge-overview" class="knowledge-anchor"></i><i id="knowledge-search" class="knowledge-anchor"></i><i id="knowledge-submit" class="knowledge-anchor"></i><i id="knowledge-tasks" class="knowledge-anchor"></i><i id="knowledge-space" class="knowledge-anchor"></i><i id="knowledge-data" class="knowledge-anchor"></i><i id="knowledge-upload" class="knowledge-anchor"></i><i id="knowledge-review" class="knowledge-anchor"></i><i id="knowledge-publish" class="knowledge-anchor"></i><i id="knowledge-library" class="knowledge-anchor"></i><i id="knowledge-connector" class="knowledge-anchor"></i><i id="knowledge-apps" class="knowledge-anchor"></i>
		<div class="knowledge-workbench">
			<aside class="knowledge-sidebar" aria-label="知识库工作台导航">
				<div class="brand">{{svg "octicon-book" 18}} 知识库工作台</div>
				<div class="section-label">我的工作</div>
				<a href="#knowledge-overview">工作台</a>
				<a href="#knowledge-search" data-step="search">查找资料</a>
				<a href="#knowledge-submit" data-step="submit">资料入库</a>
				{{if .IsAdmin}}
					<div class="section-label">治理中心</div>
					<a href="#knowledge-tasks" data-step="tasks">待办中心{{if gt .KnowledgeReviewTaskCount 0}} <span class="ui mini red circular label">{{.KnowledgeReviewTaskCount}}</span>{{end}}</a>
					<a href="#knowledge-library" data-step="library">知识台账</a>
					<a href="#knowledge-connector" data-step="connector">高级数据接入</a>
					<a href="#knowledge-apps" data-step="apps">应用授权</a>
				{{end}}
			</aside>
			<div class="knowledge-main">
			<section class="knowledge-view knowledge-overview">
		<div class="knowledge-page-header">
			<div>
				<h1 class="ui header">企业知识库</h1>
				<div class="description">从已发布的资料中找答案，或按清晰步骤把新的脱敏资料纳入知识库。</div>
			</div>
			{{if .IsAdmin}}<div>
				{{if .KnowledgeConfigError}}
					<span class="ui red label">配置未就绪</span>
				{{else}}
					<span class="ui green label">服务就绪</span>
				{{end}}
			</div>{{end}}
		</div>

		{{if and .IsAdmin .KnowledgeConfigError}}
			<div class="ui warning message">
				<div class="header">RAGFlow 配置尚未就绪</div>
				<p>{{.KnowledgeConfigError}}</p>
			</div>
		{{end}}

		<div class="ui {{if .IsAdmin}}three{{else}}two{{end}} stackable cards knowledge-next-step">
			<a href="#knowledge-search" class="ui card workflow-card knowledge-choice"><div class="content"><div class="knowledge-step-kicker">日常查询</div><div class="header">查找资料</div><div class="description">输入业务问题，查看可引用的现行资料与来源依据。</div></div></a>
			<a href="#knowledge-submit" class="ui card workflow-card knowledge-choice"><div class="content"><div class="knowledge-step-kicker">资料入库</div><div class="header">提交脱敏资料</div><div class="description">从 FileBay 仓库选择文件，按步骤提交；无需填写技术配置。</div></div></a>
			{{if .IsAdmin}}<a href="#knowledge-tasks" class="ui card workflow-card knowledge-choice"><div class="content"><div class="knowledge-step-kicker">治理中心</div><div class="header">处理待办</div><div class="description">处理来源启用、内容审核、索引发布等需要管理员确认的事项。</div></div></a>{{end}}
		</div>
		<div class="knowledge-admin-note">首次使用：查资料就点击“查找资料”；需要入库就点击“提交脱敏资料”。系统会在完成当前步骤后带你进入下一步。</div>
			</section>
			<section class="knowledge-view knowledge-search">
		<div class="knowledge-page-header"><div><h2 class="ui header">查找答案</h2><div class="description">直接输入业务问题。系统只返回你有权限查看、仍然有效的资料，并展示引用依据。</div></div></div>
		<div class="knowledge-surface">
			<div class="knowledge-surface-title">开始检索 <span class="text light-2">可按知识空间缩小范围</span></div>
			<div class="content">
			<form class="ui form" action="{{AppSubUrl}}/knowledge/search" method="post">
				<div class="fields">
					<div class="five wide field"><label>检索范围</label><select class="ui fluid selection dropdown knowledge-select" name="space_id"><option value="">我有权限的全部知识空间</option>{{range .KnowledgeSpaces}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
					<div class="nine wide required field"><label>问题</label><input name="query" value="{{.KnowledgeSearchQuery}}" placeholder="例如：客户投诉应在多长时间内响应？" maxlength="2048" required></div>
					<div class="two wide field"><label>&nbsp;</label><button class="ui primary button">检索知识</button></div>
				</div>
			</form>
			{{if .KnowledgeSearchResult}}
				<div class="ui divider"></div>
				{{if .KnowledgeSearchResult.Citations}}
					<div class="ui relaxed divided list">{{range .KnowledgeSearchResult.Citations}}<div class="item"><div class="content"><div class="header">{{.Title}}</div><div class="description">{{.Content}}</div><div class="text light-2 tw-mt-1">引用：发布 #{{.PublicationID}} · 修订 #{{.RevisionID}} · 相关度 {{printf "%.3f" .Score}}</div></div></div>{{end}}</div>
				{{else}}<div class="ui info message">未找到当前有权限且有效的知识引用。</div>{{end}}
			{{end}}
			</div>
		</div>
			</section>
			<section class="knowledge-view knowledge-submit">
				<div class="knowledge-page-header"><div><h2 class="ui header">资料入库</h2><div class="description">按顺序完成即可。系统会保留你的进度，业务人员只需填写当前步骤需要的信息。</div></div></div>
				<div class="knowledge-flow" aria-label="资料入库流程">
					<div class="knowledge-flow-step"><strong>1</strong> 知识空间</div>
					<div class="knowledge-flow-step"><strong>2</strong> 资料来源</div>
					<div class="knowledge-flow-step"><strong>3</strong> 选择文件</div>
					<div class="knowledge-flow-step"><strong>4</strong> 管理员审核</div>
					<div class="knowledge-flow-step"><strong>5</strong> 发布可检索</div>
				</div>
				{{if not .KnowledgeSpaces}}
					<div class="knowledge-current-step"><strong>当前要做：第 1 步，创建知识空间。</strong><br>知识空间用于归集同一业务主题的资料，例如“客户运营知识库”。</div>
					<div class="ui one cards knowledge-next-step"><a href="#knowledge-space" class="ui card workflow-card knowledge-choice"><div class="content"><div class="knowledge-step-kicker">第 1 步</div><div class="header">创建知识空间</div><div class="description">只需填写空间名称和用途说明，创建后继续登记资料来源。</div></div></a></div>
				{{else if not .KnowledgeEnabledDataSources}}
					<div class="knowledge-current-step"><strong>当前要做：第 2 步，登记资料来源。</strong><br>告诉系统资料来自哪里、属于哪一类；其余治理信息由管理员审核时补充。</div>
					<div class="ui one cards knowledge-next-step"><a href="#knowledge-data" class="ui card workflow-card knowledge-choice"><div class="content"><div class="knowledge-step-kicker">第 2 步</div><div class="header">登记资料来源</div><div class="description">选择知识空间、填写资料名称与类型，然后提交管理员启用。</div></div></a></div>
				{{else}}
					<div class="knowledge-current-step"><strong>当前要做：第 3 步，从仓库选择已脱敏文件。</strong><br>系统仅展示当前账号可读取且符合限制的 FileBay 仓库文件。</div>
					<div class="ui one cards knowledge-next-step"><a href="#knowledge-upload" class="ui card workflow-card knowledge-choice"><div class="content"><div class="knowledge-step-kicker">第 3 步</div><div class="header">从仓库提交资料</div><div class="description">选择已启用来源和已脱敏文件，提交后交由管理员完成审核、索引与发布。</div></div></a></div>
				{{end}}
				<div class="ui warning message"><div class="header">仅提交已脱敏资料</div><p>客户信息、个人信息和未经审批的原件必须先在本地完成脱敏。提交人无需负责审核与发布。</p></div>
			</section>
			<section class="knowledge-view knowledge-tasks">
				{{if .IsAdmin}}
					<h2 class="ui header tw-mb-1">待我处理</h2>
					<div class="text light-2 tw-mb-3">这里是知识管理员的工作入口。按待办处理即可，不需要先浏览资料台账或技术配置。</div>
					<div class="ui three stackable cards knowledge-next-step">
